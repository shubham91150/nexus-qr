# ===========================================
# NEXUS QR - Environment Variables
# ===========================================
#
# IMPORTANT: Never commit your actual keys!
# In Vercel, add these as Environment Variables in your project settings.
#

# Gemini API Key (Required for AI Magic feature)
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase URL (Required for database connections)
# Get this from: Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Key (Required for Dynamic QR redirect tracking)
# Get this from: Supabase Dashboard → Project Settings → API → service_role key
# WARNING: This is a secret key with full database access. Never expose to client!
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ===========================================
# PADDLE PAYMENT GATEWAY (Required for Subscriptions)
# ===========================================
# Get these from: https://vendors.paddle.com/authentication
# Use sandbox for testing: https://sandbox-vendors.paddle.com

# Paddle Client Token (for frontend checkout)
VITE_PADDLE_CLIENT_TOKEN=your_paddle_client_token

# Paddle Environment (sandbox or production)
VITE_PADDLE_ENVIRONMENT=sandbox

# Paddle Price IDs - Get these from Paddle Dashboard after creating products
# Starter Plan
VITE_PADDLE_STARTER_MONTHLY=pri_starter_monthly
VITE_PADDLE_STARTER_YEARLY=pri_starter_yearly

# Pro Plan
VITE_PADDLE_PRO_MONTHLY=pri_pro_monthly
VITE_PADDLE_PRO_YEARLY=pri_pro_yearly

# Business Plan
VITE_PADDLE_BUSINESS_MONTHLY=pri_business_monthly
VITE_PADDLE_BUSINESS_YEARLY=pri_business_yearly

# Enterprise Plan
VITE_PADDLE_ENTERPRISE_MONTHLY=pri_enterprise_monthly
VITE_PADDLE_ENTERPRISE_YEARLY=pri_enterprise_yearly

# Paddle Webhook Secret (for backend webhook verification)
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret

# ===========================================
# RESEND EMAIL SERVICE (Required for Scan Notifications)
# ===========================================
# Get your API key from: https://resend.com/api-keys
# The API key should start with 're_' (e.g., re_abc123...)

# Resend API Key (Required for email notifications)
RESEND_API_KEY=re_your_resend_api_key_here

# Custom From Email (Optional - requires verified domain in Resend)
# Default: Nexus QR <onboarding@resend.dev> (only sends to account owner's email)
# RESEND_FROM_EMAIL=Nexus QR <noreply@yourdomain.com>
