# ===========================================
# NEXUS QR - Environment Variables
# ===========================================
#
# IMPORTANT: Never commit your actual keys!
# In Vercel, add these as Environment Variables in your project settings.
#

# Gemini API Key (Required for AI Magic feature)
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Service Key (Required for Dynamic QR redirect tracking)
# Get this from: Supabase Dashboard → Project Settings → API → service_role key
# WARNING: This is a secret key with full database access. Never expose to client!
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
